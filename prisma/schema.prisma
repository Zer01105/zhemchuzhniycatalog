generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/data/catalog/app.db"
}

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  password  String
  role      String   @default("client")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
}

model ArticleTag {

  id         String   @id @default(cuid())

  section    String

  article    String

  productKey String   @default("")

  tagId      String

  createdAt  DateTime @default(now())

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([section, article, productKey, tagId])

}
model ArticleMeta {
  id          String   @id @default(cuid())
  section     String
  article     String
  weight      String?
  price       String?
  material    String?
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([section, article])
}
model ArticleAttribute {
  id         String   @id @default(cuid())
  section    String
  article    String
  productKey String   @default("")
  name       String
  value      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([section, article, productKey, name])
}

model ProductSetItem {
  id         String   @id @default(cuid())
  setKey     String
  section    String
  article    String
  productKey String
  createdAt  DateTime @default(now())

  @@unique([setKey, section, article, productKey])
}

model AutoTagRule {
  id         String   @id @default(cuid())
  name       String
  matchType  String
  matchValue String
  tagName    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
